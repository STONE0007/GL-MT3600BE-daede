# 目标机型架构
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_glinet_gl-mt3600be=y

# daede 双内核与核心依赖
CONFIG_PACKAGE_luci-app-daede=y
CONFIG_PACKAGE_dae=y
CONFIG_PACKAGE_daed=y
CONFIG_PACKAGE_vmlinux-btf=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_tc-bpf=y
CONFIG_PACKAGE_bpftool-minimal=y

# 常用网络工具与时区补齐
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_zoneinfo-asia=y
CONFIG_PACKAGE_kmod-button-hotplug=y

# 内存调优与主题
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-lib-zstd=y
CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_PACKAGE_luci-app-aurora-config=y
# CONFIG_PACKAGE_luci-theme-bootstrap is not set
