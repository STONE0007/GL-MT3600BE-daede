# 目标硬件架构
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_glinet_gl-mt3600be=y

# 核心网络工具升级（解锁 Netkit，严防 fallback to veth）
CONFIG_PACKAGE_ip-full=y
# CONFIG_PACKAGE_ip-tiny is not set
CONFIG_PACKAGE_tc-bpf=y

# 内核原生嵌入 BTF 字典（生成 /sys/kernel/btf/vmlinux，停用独立安装包）
CONFIG_KERNEL_DEBUG_INFO=y
CONFIG_KERNEL_DEBUG_INFO_BTF=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
# CONFIG_PACKAGE_vmlinux-btf is not set
CONFIG_PACKAGE_kmod-btf=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-sched-bpf=y

# 内存压缩与调优支持
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-lib-zstd=y

# daede 双内核完全体与控制面板
CONFIG_PACKAGE_luci-app-daede=y
CONFIG_PACKAGE_dae=y
CONFIG_PACKAGE_daed=y
# CONFIG_PACKAGE_luci-app-daed is not set

# 主题、外观及兼容运行时
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lua-runtime=y
CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_PACKAGE_luci-app-aurora-config=y
# CONFIG_PACKAGE_luci-theme-bootstrap is not set

# 界面中文语言包支持
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-aurora-config-zh-cn=y
CONFIG_PACKAGE_luci-i18n-daede-zh-cn=y

# 配套网络转发模块与实用工具
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_zoneinfo-asia=y
CONFIG_PACKAGE_bpftool-minimal=y
CONFIG_PACKAGE_kmod-button-hotplug=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-fib=y

# 彻底根治 /invalid/clang 拦截：反选默认值并强制锁定宿主机 LLVM/Clang
CONFIG_DEVEL=y
# CONFIG_BPF_TOOLCHAIN_NONE is not set
# CONFIG_BPF_TOOLCHAIN_BUILD_LLVM is not set
CONFIG_BPF_TOOLCHAIN_HOST_LLVM=y
CONFIG_BPF_TOOLCHAIN_HOST_PATH="/usr/bin"
